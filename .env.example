# Cirkle Identity Verification — environment variables
# Copy this to .env (local) or set in your hosting platform (production)

# ─── Database ───────────────────────────────────────────────────────────────
# LOCAL DEV (SQLite file):
DATABASE_URL=file:/home/z/my-project/db/custom.db

# PRODUCTION (Cirkle Turso libSQL — primary):
# DATABASE_URL=libsql://cirkle-fortleem.aws-us-east-1.turso.io
# DATABASE_AUTH_TOKEN=<your-turso-token>

# PRODUCTION (Neon PostgreSQL — mirror/backup):
# NEON_DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/dbname?sslmode=require

# ─── AI Consensus Providers (all FREE tier, no billing) ─────────────────────
# Set ANY of these to enable multi-provider consensus cross-checking.
# When ALL are unset, the app gracefully falls back to self-hosted engines only.
#
# 1. Google Gemini (vision + text) — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 2. Groq (fastest text, 500+ tok/s) — https://console.groq.com/keys
GROQ_API_KEY=

# 3. OpenRouter (multi-model, free tier) — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# 4. NVIDIA NIM (GPU inference + vision) — https://build.nvidia.com/
NVIDIA_API_KEY=

# 5. HuggingFace Inference API — https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=

# ─── Consensus mode behavior ────────────────────────────────────────────────
# With 0 keys  → self-hosted only (Tesseract + face-api + custom liveness)
# With 1+ keys → AI consensus runs IN PARALLEL with self-hosted engines;
#               per-field majority vote + similarity clustering + agreement score
# Recommended: set at least GEMINI_API_KEY + GROQ_API_KEY for best cross-check.

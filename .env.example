# ═══════════════════════════════════════════════════════════════════════════
# Cirkle Identity Verification — Environment Variables
# APPROVED PROVIDERS: GitHub · Cloudflare · Vercel · Inngest · Turso · Neon · Brevo
# EXPLICITLY REMOVED: Cloudflare R2, Resend
# ═══════════════════════════════════════════════════════════════════════════

# ─── Turso (AUTHORITATIVE transactional database) ───────────────────────────
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-turso-token
# Local SQLite fallback for dev:
DATABASE_URL=file:/home/z/my-project/db/custom.db

# ─── Neon (RECOVERY projection — NOT for ordinary writes) ───────────────────
# Receives events from outbox via Inngest relay. NEVER direct business writes.
NEON_DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/db?sslmode=require

# ─── Vercel Blob (small object storage — 1GB/10k ops/10GB transfer free) ──
# Set in Vercel project settings → Storage. Not needed for local dev.
# BLOB_READ_WRITE_TOKEN=

# ─── Cloudflare (edge / DNS — NOT R2) ──────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ─── Inngest (durable workflows) ───────────────────────────────────────────
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=

# ─── Brevo (transactional email — 300/day free) ───────────────────────────
BREVO_API_KEY=

# ─── SMS (customer-funded — provider-neutral, NOT platform-funded) ─────────
SMS_PROVIDER=none
# SMS_PROVIDER_API_KEY= (set only when customer authorizes a paid provider)

# ─── AI Consensus Providers (FREE tier — multi-provider cross-checking) ────
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
HUGGINGFACE_API_KEY=

# ─── Platform admin (for controlled database promotion) ───────────────────
PLATFORM_ADMIN_SECRET=

# ═══════════════════════════════════════════════════════════════════════════
# EXPLICITLY ABSENT (per architecture mandate):
#   CLOUDFLARE_R2_* / R2_* / @aws-s3     → REMOVED from baseline (billed beyond 10GB)
#   RESEND_* / resend                     → replaced by Brevo
#
# ARCHITECTURAL INVARIANTS:
#   Turso = truth (authoritative)
#   Neon = recovery (projection only — never direct writes)
#   Cloudflare = edge (NOT storage)
#   Vercel Blob = small objects only (quota-governed)
#   Inngest = durable workflows (NOT sync CRUD)
#   Brevo = email (300/day hard limit, P0-P4 governor)
#   SMS = customer-funded (explicit authorization required)
#   GitHub = source/CI
#
# COST POLICY:
#   ZERO-COST-BY-DEFAULT. FAIL CLOSED when free quota exhausted.
#   Never silently shift cost to platform owner. Never auto-upgrade.
# ═══════════════════════════════════════════════════════════════════════════

# Cirkle Identity Verification — environment variables
# Copy this to .env (local) or set in your hosting platform (production)

# ─── Database ───────────────────────────────────────────────────────────────
# LOCAL DEV (SQLite file):
DATABASE_URL=file:/home/z/my-project/db/custom.db

# PRODUCTION (Cirkle Turso libSQL — primary):
# DATABASE_URL=libsql://cirkle-fortleem.aws-us-east-1.turso.io
# DATABASE_AUTH_TOKEN=<your-turso-token>

# PRODUCTION (Neon PostgreSQL — mirror/backup):
# NEON_DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/dbname?sslmode=require

# ─── Optional: Z.ai VLM (already bundled in the SDK, no key needed) ──────────
# The z-ai-web-dev-sdk is pre-authenticated; no API key required.
